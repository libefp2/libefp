# Regression test: fragment frames not centered at the center of mass. pentacene_shift.efp has its
# internal frame 500 bohr away from the molecule (tests/tools/make_parse_test_fragments.py); with atom
# coordinates, its parameters used to be placed relative to that origin. The energy must equal the one
# with pentacene_l (coord_com_1a), which is the energy of parse_labels_2a (same geometry, coord points).
run_type gtest
ref_energy -0.0065500983
coord atoms
terms elec pol disp xr
elec_damp screen
pol_damp tt
disp_damp overlap
fraglib_path ../fraglib

fragment pentacene_shift
