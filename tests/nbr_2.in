# Regression test: neighbor lists (cell lists) of the fragments within the cutoff, periodic orthogonal box (3 cells per direction).
# 512 water molecules on a 3 A grid; the reference energy is from the code before neighbor lists,
# where every pair was tested against the cutoff.
run_type etest
ref_energy 1.2809629724
coord xyzabc
terms elec pol disp xr
elec_damp screen
disp_damp tt
pol_damp tt
fraglib_path ../fraglib
enable_cutoff true
swf_cutoff 7.0
enable_pbc true
periodic_box 24.0 24.0 24.0 90.0 90.0 90.0

